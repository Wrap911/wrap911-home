+    @objc func diagnostics(_ call: CAPPluginCall) {
+        Task { @MainActor in
+            let scenes = UIApplication.shared.connectedScenes.compactMap { $0 as? UIWindowScene }
+            let active = scenes.first { $0.activationState == .foregroundActive } ?? scenes.first
+            let windows = active?.windows ?? []
+            let window = windows.first { $0.isKeyWindow } ?? windows.first
+            let root = window?.rootViewController
+            let info = Bundle.main.infoDictionary ?? [:]
+            call.resolve([
+                "build": info["CFBundleVersion"] as? String ?? "",
+                "version": info["CFBundleShortVersionString"] as? String ?? "",
+                "canMakePayments": SKPaymentQueue.canMakePayments(),
+                "sceneCount": scenes.count,
+                "windowCount": windows.count,
+                "windows": windows.map { String(describing: type(of: $0)) }.joined(separator: "+"),
+                "keyWindow": window?.isKeyWindow ?? false,
+                "rootInWindow": root?.viewIfLoaded?.window != nil,
+                "root": root.map { String(describing: type(of: $0)) } ?? ""
+            ])
+        }
